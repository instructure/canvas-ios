          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI La búsqueda que, en este momento, está en desarrollo para Canvas, usa algoritmos semánticos e inteligencia artificial para comprender el contexto de la consulta y el significado semántico, no solo una coincidencia de palabras clave."
