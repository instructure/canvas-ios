    "One or more files failed to sync. Check your internet connection and retry to submit." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذرت مزامنة ملف واحد أو أكثر. تحقق من اتصالك بالإنترنت وأعد محاولة الإرسال."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No s'han pogut sincronitzar un o més fitxers. Reviseu la connexió a Internet i torneu a provar de fer l'entrega."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wedi methu cysoni un neu ragor o ffeiliau. Gwiriwch eich cysylltiad rhyngrwyd a rhoi cynnig arall ar gyflwyno."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En eller flere filer kunne ikke synkronisere. Kontroller din internetforbindelse, og prøv igen for at aflevere."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
