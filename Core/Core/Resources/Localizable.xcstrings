    "This will sync ~%@ content. It may result in additional charges from your data provider if you are not connected to a Wi-Fi network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى مزامنة ~%@ من المحتوى. وقد يؤدي هذا إلى رسوم إضافية من موفر الخدمة إذا لم تكن متصلاً بشبكة Wi-Fi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amb aquesta operació se sincronitzarà el contingut de ~%@. Si no us heu connectat a cap xarxa Wi-Fi, és possible que el proveïdor de dades us cobri algun import addicional."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
