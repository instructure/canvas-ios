        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI La búsqueda, actualmente en desarrollo por Canvas, utiliza algoritmos semánticos y de IA para entender el contexto y el significado semántico, no solo la coincidencia de palabras clave."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Haku, jota kehitetään parhaillaan Canvasille, käyttää semanttisia algoritmeja ja tekoälyä kyselyn kontekstin ja semanttisen merkityksen ymmärtämiseen, ei vain avainsanahaun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Actuellement en cours de développement pour Canvas, la fonctionnalité de recherche utilise des algorithmes sémantiques et l’IA pour comprendre le contexte et la signification sémantique des interrogations, elle ne se contente pas seulement d’établir des correspondances avec des mots clés"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI La recherche, actuellement en cours de développement pour Canvas, utilise des algorithmes sémantiques et l’IA pour comprendre le contexte de la requête et la signification sémantique, et pas seulement la correspondance des mots-clés."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Úsáideann Search, atá á fhorbairt faoi láthair do Canvas, halgartaim shéimeantacha agus hintleacht shaorga chun comhthéacs fiosrúcháin agus brí shéimeantach a thuiscint, ní hamháin meaitseáil eochairfhocal."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Canvas के लिए वर्तमान में विकास के चरण में मौजूद सर्च, क्वेरी के संदर्भ और अर्थ संबंधी अर्थ को समझने के लिए सेमेंटिक एल्गोरिदम और AI का उपयोग करता है, न कि केवल कीवर्ड मिलान का।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Search, k ap devlope kounye a pou Canvas, sèvi ak algorit semantik ak AI pou konprann kontèks rechèch la ak sans semantik, pa sèlman konpare mo kle yo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Pencarian, saat ini sedang dikembangkan untuk Canvas, menggunakan algoritme semantik dan AI untuk memahami konteks pertanyaan dan makna semantik, bukan hanya pencocokan kata kunci."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Search, sem nú er í þróun fyrir Canvas, notar merkingarfræðileg reiknirit og gervigreind til að skilja samhengi fyrirspurna og merkingarfræðilega merkingu, ekki bara leitarorðasamsvörun."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Cerca, attualmente in fase di sviluppo per Canvas, utilizza algoritmi semantici e l’IA per comprendere il contenuto della query e il significato semantico, non solo la corrispondenza con la parola chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI 現在 Canvas 向けに開発中の検索は、キーワード マッチングだけでなく、セマンティック アルゴリズムと AI を使用してクエリ コンテキストおよびセマンティックな意味を理解します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI 현재 Canvas에 대해 개발 중인 검색은 의미론적 알고리즘과 AI를 사용하여 단순히 검색어 일치만이 아닌 쿼리 컨텍스트 및 의미론적 의도를 이해합니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IgniteAI Kei te whakawhanakehia a Search mō Canvas i tēnei wā, ā, e whakamahi ana i ngā rauropi tikanga me te AI hei mārama ki te horopaki patai me te tikanga tikanga, ehara i te mea ko te taurite kupumatua anake."
