    "Content sync might use cellular data which may result in extra fees from your data provider." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ربما تستخدم مزامنة المحتوى بيانات شبكة الجوّال التي قد تتسبب في رسوم إضافية من موفر البيانات."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "És possible que per sincronitzar el contingut es facin servir dades mòbils, per la qual cosa el vostre proveïdor de dades podria aplicar-vos càrrecs extres."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efallai y bydd cysoni data yn defnyddio data symudol a all arwain at ffioedd ychwanegol gan eich darparwr data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indholdssynkronisering kan bruge mobildata, hvilket kan resultere i ekstra gebyrer fra din dataudbyder."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indholdssynkronisering kan bruge mobildata, hvilket kan resultere i ekstra gebyrer fra din dataudbyder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei der Synchronisierung von Inhalten werden möglicherweise Mobilfunkdaten verwendet, was zu zusätzlichen Gebühren bei Ihrem Datenanbieter führen kann."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content sync might use cellular data which may result in extra fees from your data provider."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content sync might use cellular data which may result in extra fees from your data provider."
          }
