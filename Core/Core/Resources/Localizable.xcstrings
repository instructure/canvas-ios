        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odotetaan tärkeiden asioiden tapahtumista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente que des choses importantes aient lieu."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendre que des choses importantes se produisent."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ag fanacht chun go dtarlóidh rudaí tábhachtacha."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "महत्वपूर्ण चीज़ों के घटित होने का इंतज़ार किया जा रहा है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atann gen bagay serye ki pral fèt."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu terjadinya hal penting."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Býð eftir að mikilvægir hlutir gerist."
