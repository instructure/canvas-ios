    "We’re working hard to find the best matches for your search. This won't take long! Thank you for your patience." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحاول بقوة للعثور على أفضل النتائج المطابقة لبحثك. لن يأخذ هذا الأمر وقتًا طويلاً! شكرًا لك على انتظارك."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ens esforcem per trobar les millors coincidències per a la vostra cerca. Això no tardarà gaire. Gràcies per la vostra paciència."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rydym yn gweithio'n galed i ddod o hyd i'r hyn sy’n cyfateb orau i’ch proses chwilio. Ni fydd hyn yn cymryd yn hir! Diolch am eich amynedd."
