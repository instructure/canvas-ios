          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhden tai useamman tiedoston synkronisointi ei onnistunut. Tarkista Internet-yhteytesi ja yritä lähettää uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
