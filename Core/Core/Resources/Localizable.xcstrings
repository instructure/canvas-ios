        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for trying the new dashboard! Could you tell us why you switched back?"
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for trying the new dashboard! Could you tell us why you switched back?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por probar el nuevo tablero. ¿Podría decirnos por qué volvió al diseño anterior?"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Gracias por probar el nuevo panel de control! ¿Podrías decirnos por qué has vuelto a cambiar?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiitos uuden koontinäytön kokeilemisesta! Voitko kertoa, miksi vaihdoit takaisin?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci d’avoir essayé le nouveau tableau de bord ! Pourriez-vous nous dire pourquoi vous avez décidé de revenir à la disposition initiale ?"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merci d’avoir essayé le nouveau tableau de bord! Pouvez-vous nous dire pourquoi vous avez changé d’avis?"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go raibh maith agat as an deais nua a thriail! An bhféadfá a insint dúinn cén fáth ar athraigh tú ar ais?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नया डैशबोर्ड आज़माने के लिए शुक्रिया! क्या आप बता सकते हैं कि आपने वापस स्विच क्यों किया?"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mèsi paske w eseye nouvo tablodbò a! Èske ou ka di nou poukisa ou tounen sou sa anvan an?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih telah mencoba dashboard baru! Bisakah Anda memberi tahu kami mengapa Anda beralih kembali?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk fyrir að prufa nýja stjórnborðið! Geturðu útskýrt af hverju þú skiptir til baka?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grazie per aver provato la nuova dashboard! Puoi raccontarci perché hai cambiato idea?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいダッシュボードをお試しいただき、ありがとうございます！元に戻した理由をお聞かせいただけますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 대시보드를 시도해 주셔서 감사합니다. 되돌린 이유를 알려 주시겠습니까?"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngā mihi mō te whakamātau i te papaaho hou! Ka taea e koe te kōrero mai he aha koe i hoki anō ai?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terima kasih kerana mencuba papan pemuka baharu! Bolehkah anda memberitahu kami kenapa anda menukarnya kembali?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk for at du prøver det nye dashbordet! Kan du fortelle oss hvorfor du byttet tilbake?"
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takk for at du prøver det nye oversikten! Kan du fortelle oss hvorfor du byttet tilbake?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bedankt dat je het nieuwe dashboard hebt geprobeerd! Kun je ons vertellen waarom je bent teruggekeerd naar het oude dashboard?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziękujemy za wypróbowanie nowego pulpitu nawigacyjnego! Czy możesz nam powiedzieć, dlaczego powróciłeś do poprzedniej wersji?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado por experimentar o novo painel! Pode dizer-nos por que voltou ao layout anterior?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obrigado por experimentar o novo painel! Você poderia nos dizer por que voltou atrás?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спасибо за использование новой панели управления! Не могли бы вы указать, почему вы переключились обратно?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvala za preskus nove nadzorne plošče! Nam lahko poveste, zakaj ste preklopili nazaj?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tack för att du provade den nya översikten! Vill du berätta varför du ändrade tillbaka?"
