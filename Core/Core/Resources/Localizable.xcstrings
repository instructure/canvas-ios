    "One of your submissions is still being uploaded. Logging out might interrupt it.\nAre you sure you want to log out?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". قد يؤدي تسجيل الخروج إلى إيقافه. هل تريد بالتأكيد تسجيل الخروج؟\nأحد إرسالاتك ما زالت قيد التحمي"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de les entregues encara s’està carregant. En tancar la sessió pot ser que s’interrompi.\nSegur que voleu tancar la sessió?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae un o’ch cyflwyniadau yn dal i gael ei lwytho i fyny. Gallai allgofnodi darfu ar hyn.\nYdych chi’n siŵr eich bod am allgofnodi?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En af dine afleveringer uploades stadig. Hvis du logger ud, kan processen blive afbrudt.\nEr du sikker på, du vil logge af?"
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En af dine afleveringer uploades stadig. Hvis du logger ud, kan processen blive afbrudt.\nEr du sikker på, du vil logge af?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ihrer Abgaben wird gerade hochgeladen. Abmelden führt möglicherweise zum Abbruch.\nMöchten Sie sich wirklich abmelden?"
          }
        },
        "en-AU" : {
