          "stringUnit" : {
            "state" : "translated",
            "value" : "Tindakan ini akan menyegerakkan ~%@ kandungan. Hal ini mungkin akan menyebabkan anda dikenakan caj tambahan oleh penyedia data anda sekiranya anda tidak bersambung ke rangkaian Wi-Fi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil synkronisere ~%@-innhold. Dette kan føre til ekstra kostnader fra din datatilbyder hvis du ikke er koblet til et Wi-Fi-nettverk."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil synkronisere ~%@-innhold. Dette kan føre til ekstra kostnader fra din datatilbyder hvis du ikke er koblet til et Wi-Fi-nettverk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee wordt ~%@ inhoud gesynchroniseerd. Je gegevensprovider kan extra kosten in rekening brengen als je niet bent verbonden met een wifi-netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to synchronizację zawartości ~%@. Może to prowadzić do naliczenia dodatkowych opłat przez Twojego dostawcę transmisji danych, jeśli nie masz połączenia z siecią Wi-Fi."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto irá sincronizar o conteúdo ~%@. Poderá resultar em custos adicionais do seu fornecedor de dados se não estiver ligado a uma rede Wi-Fi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso sincronizará o conteúdo ~%@. Isso pode resultar em cobranças adicionais do seu provedor de dados se você não estiver conectado a uma rede Wi-Fi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будет выполнена синхронизация содержимого ~%@. Это может привести к дополнительным расходам со стороны поставщика данных, если вы не подключены к сети Wi-Fi."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tem boste sinhronizirali vsebino ~%@ Ponudnik podatkov vam lahko zaračuna dodatne stroške, če niste povezani v omrežje Wi-Fi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta synkroniserar ~%@-innehåll. Detta kan medföra ytterligare kostnader från din dataleverantör om du inte är ansluten till ett wifi-nätverk."
          }
        },
        "sv-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detta synkroniserar ~%@-innehåll. Detta kan medföra ytterligare kostnader från din dataleverantör om du inte är ansluten till ett wifi-nätverk."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นี่จะเป็นการซิงค์ข้อมูล ~%@ อาจมีค่าบริการเพิ่มเติมจากผู้ให้บริการเครือข่ายหากคุณไม่ได้เชื่อมต่อกับเครือข่าย  Wi-Fi"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thao tác này sẽ đồng bộ ~%@ nội dung. Điều này có thể khiến bạn bị tính thêm phí từ nhà cung cấp dữ liệu của bạn nếu bạn không kết nối với mạng Wi-Fi."
          }
        },
        "zh" : {
