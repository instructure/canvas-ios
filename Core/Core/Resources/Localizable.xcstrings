    "If this setting is enabled the content synchronization will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا تم تمكين هذا الإعداد، فلن تتم مزامنة المحتوى إلا إذا اتصل الجهاز بشبكة Wi-Fi، وإلا إذا تم تأجيل المزامنة حتى تتوفر شبكة Wi-Fi."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aquest paràmetre està activat, només se sincronitzarà el contingut si el dispositiu es connecta a una xarxa Wi-Fi; en cas contrari, l’acció es posposarà fins que hi hagi una xarxa Wi-Fi disponible."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ydy’r gosodiad hwn wedi’i alluogi dim ond pan fydd y ddyfais wedi’i chysylltu i rwydwaith Wi-Fi y bydd cysoni cynnwys yn digwydd, fel arall bydd yn cael ei ohirio nes bod rhwydwaith Wi-Fi ar gael."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis denne indstilling er aktiveret, vil indholdssynkroniseringen kun gennemføres, hvis enheden opretter forbindelse til et wi-fi-netværk, ellers vil det blive udskudt, indtil et wi-fi-netværk er tilgængeligt."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis denne indstilling er aktiveret, vil indholdssynkroniseringen kun gennemføres, hvis enheden opretter forbindelse til et wi-fi-netværk, ellers vil det blive udskudt, indtil et wi-fi-netværk er tilgængeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn diese Einstellung aktiviert ist, erfolgt die Inhaltssynchronisierung nur, wenn das Gerät mit einem WLAN-Netzwerk verbunden ist. Andernfalls wird sie verschoben, bis ein WLAN-Netzwerk verfügbar ist."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled, the content synchronisation will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled, the content synchronisation will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled the content synchronization will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled the content synchronisation will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled the content synchronisation will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If this setting is enabled the content synchronisation will only happen if the device connects to a Wi-Fi network, otherwise it will be postponed until a Wi-Fi network is available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si esta configuración está habilitada, la sincronización de contenido solo se realizará si el dispositivo se conecta a una red Wi-Fi; de lo contrario, se postergará hasta que haya una red Wi-Fi disponible."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se habilita está configuración, la sincronización del contenido solo se realizará si el dispositivo se conecta a una red wifi, de lo contrario se pospondrá hasta que haya una red wifi disponible."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä asetus on käytössä, sisällön synkronisointi tapahtuu, jos laite on yhteydessä Wifi-verkkoon. Muussa tapauksessa tätä lykätään, kun Wifi-verkko on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ce paramètre est activé, la synchronisation du contenu n'aura lieu que si l’appareil est connecté à un réseau Wi-Fi. Dans le cas contraire, elle sera repoussée jusqu'à ce qu'un réseau Wi-Fi soit disponible."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ce paramètre est activé, la synchronisation du contenu ne se produira que si l’appareil se connecte à un réseau Wi-Fi, sinon elle sera reportée jusqu’à ce qu’un réseau Wi-Fi soit disponible."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Má tá an socrú seo cumasaithe ní tharlóidh sioncrónú ábhair ach amháin má nascann an gléas le gréasán Wi-Fi, nó cuirfear ar athló é go dtí go mbeidh gréasán Wi-Fi ar fáil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि यह सेटिंग सक्षम है, तो सामग्री सिंक्रोनाइज़ेशन केवल तभी होगा जब डिवाइस वाई-फ़ाई नेटवर्क से कनेक्ट होगा, अन्यथा उसे वाई-फ़ाई नेटवर्क उपलब्ध होने तक स्थगित कर दिया जाएगा।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SI reglaj la aktive, senkwonizasyon kontni an ap fèt sèlman si aparèy la konekte sou yon rezo wifi, sinon, l ap ranvwaye pou lè gen yon koneksyon sou wifi ki disponib."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika pengaturan ini diaktifkan, sinkronisasi konten hanya akan terjadi jika perangkat tersambung ke jaringan Wi-Fi; jika tidak, akan ditunda hingga jaringan Wi-Fi tersedia."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þessi stilling er virkjuð mun samstilling efnis aðeins eiga sér stað ef tækið tengist Wi-Fi neti, annars verður henni frestað þar til Wi-Fi net er tiltækt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se questa impostazione è attiva, la sincronizzazione del contenuto sarà eseguita solo se il dispositivo si collega ad una rete Wi-Fi, diversamente sarà posticipata fino a quando non sarà disponibile una rete Wi-Fi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この設定を有効にすると、コンテンツの同期はデバイスがWi-Fiネットワークに接続されている場合にのみ行われます（それ以外の場合は、Wi-Fiネットワークが利用可能になるまで延期されます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정으로 사용으로 설정한 경우 장치가 Wi-Fi 네트워크에 연결된 상태에서만 동기화합니다. 그렇지 않은 경우 Wi-Fi 네트워크가 사용 가능하게 될 때까지 동기화를 지연합니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko te tukutahitanga ihirangi ka mahi mena ka hono te taputapu ki te whatunga Wi-Fi mena ka whakahohea tenei tautuhinga; ki te kore, ka whakaroa kia watea mai he whatunga Wi-Fi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tetapan ini didayakan penyegerakan kandungan hanya akan berlaku jika peranti terhubung dengan rangkaian Wi-Fi, jika tidak, ia akan ditangguhkan sehingga rangkaian Wi-Fi tersedia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis denne innstillingen er aktivert, vil innholdssynkroniseringen bare skje hvis enheten er koblet til et Wi-Fi-nettverk. Hvis ikke, vil det bli utsatt til et Wi-Fi-nettverk er tilgjengelig."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis denne innstillingen er aktivert, vil innholdssynkroniseringen bare skje hvis enheten er koblet til et Wi-Fi-nettverk. Hvis ikke, vil det bli utsatt til et Wi-Fi-nettverk er tilgjengelig."
