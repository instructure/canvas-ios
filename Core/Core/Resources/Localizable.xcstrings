    "Modules and items that have already been processed will not be reverted to their previous state when the process is discontinued." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يتم عكس الوحدات والعناصر التي تمت معالجتها بالفعل إلى حالتها السابقة عند إيقاف العملية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els continguts i els elements que ja s’hagin processat no es revertiran al seu estat anterior un cop interromput el procés."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni fydd modiwlau ac eitemau sydd eisoes wedi’u prosesu yn dychwelyd i’w cyflwr blaenorol pan fyddwch chi’n rhoi’r gorau i’r broses."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduler og elementer, der allerede er blevet behandlet, vil ikke blive ført tilbage til deres tidligere tilstand, når processen afbrydes."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forløb og elementer, der allerede er blevet behandlet, vil ikke blive ført tilbage til deres tidligere tilstand, når processen afbrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Module und Elemente, die bereits verarbeitet wurden, werden nicht in den vorherigen Zustand zurückversetzt, wenn der Vorgang abgebrochen wird."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modules and items that have already been processed will not be reverted to their previous state when the process is discontinued."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modules and items that have already been processed will not be reverted to their previous state when the process is discontinued."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modules and items that have already been processed will not be reverted to their previous state when the process is discontinued."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Units and items that have already been processed will not be reverted to their previous state when the process is discontinued."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modules and items that have already been processed will not be reverted to their previous state when the process is discontinued."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Units and items that have already been processed will not be reverted to their previous state when the process is discontinued."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se interrumpe el proceso, los módulos y los ítems que ya hayan sido procesados no volverán a su estado previo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los módulos e ítems que ya se hayan procesado no volverán a su estado anterior cuando el proceso esté interrumpido."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduulit ja kohteet, jotka on jo käsitelty ei palauteta aikaisempaan tilaan, kun käsittely keskeytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modules et éléments déjà traités ne seront pas ramenés à leur état initial si le processus est interrompu."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modules et les éléments qui ont déjà été traités ne retrouveront pas leur état précédent lorsque le processus sera interrompu."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní rachaidh modúil agus míreanna atá próiseáilte cheana féin ar ais chuig a staid roimhe sin nuair a scoirtear den phróiseas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जो मॉड्यूल और आइटम पहले ही संसाधित हो चुके हैं, प्रक्रिया बंद होने पर अपनी पूर्वस्थिति में वापस नहीं आएंगे।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modil ak atik ki te deja trete yo pa p retounen nan eta yo te ye anvan an lè pwosesis la sipann."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul dan item yang sudah diproses tidak akan dikembalikan ke kondisi sebelumnya ketika proses dihentikan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Námsefni og atriði sem þegar hafa verið unnin verða ekki færð í fyrra ástand þegar ferlinu er hætt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando il processo viene interrotto, i moduli e gli elementi già elaborati non saranno riportati al loro stato precedente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すでに処理されているモジュールや項目は、処理を中止しても以前の状態には戻りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미 처리된 모듈 및 항목은 프로세스가 멈춰도 이전 상태로 되돌리지 않습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko nga waahanga me nga mea kua oti te tukatuka e kore e hoki ki to ratau ahuatanga o mua ka haukotia te tukanga."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modul dan item yang telah diproses tidak akan ditukar kembali kepada keadaan sebelumnya apabila proses dihentikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduler og elementer som allerede er behandlet, vil ikke bli tilbakestilt til tidligere tilstand når prosessen avbrytes."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduler og elementer som allerede er behandlet, vil ikke bli tilbakestilt til tidligere tilstand når prosessen avbrytes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modules en items die al zijn verwerkt, worden niet naar hun eerdere status teruggezet wanneer het proces wordt stopgezet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetworzone moduły i elementy nie zostaną przywrócone do poprzedniego stanu, jeśli proces zostanie przerwany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os módulos e itens que já tenham sido processados não serão revertidos para o seu estado anterior quando o processo for interrompido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os módulos e itens que já foram processados não serão revertidos ao estado anterior quando o processo for interrompido."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модули и элементы, которые уже были обработаны, не будут возвращены в прежнее состояние при остановке процедуры."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduli in elementi, ki so bili že obdelani, po prekinitvi procesa ne bodo povrnjeni v predhodno stanje."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduler som redan har bearbetats återställs inte till tidigare tillstånd är processen avslutas."
          }
        },
        "sv-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moduler som redan har bearbetats återställs inte till tidigare tillstånd är processen avslutas."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หน่วยการเรียนและรายการที่ดำเนินการไปแล้วจะไม่กลับคืนเป็นสถานะก่อนหน้าเมื่อมีการยุติการดำเนินการ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các học phần và mục đã được xử lý sẽ không được hoàn nguyên về trạng thái trước đó khi ngừng quá trình."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止处理后，已经处理的模块和项目不会退回到之前的状态。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "停止处理后，已经处理的模块和项目不会退回到之前的状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "中止處理時，已處理的單元和項目將不會回復到之前的狀態。"
