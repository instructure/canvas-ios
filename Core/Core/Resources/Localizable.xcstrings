        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sur le point de passer au tableau de bord classique. Vous pouvez revenir en arrière plus tard dans l’écran Paramètres du tableau de bord."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá tú ar tí aistriú go dtí an deais clasaiceach. Is féidir leat athrú ar ais níos déanaí ar an scáileán Socruithe Deais."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप क्लासिक डैशबोर्ड पर स्विच करने वाले है। आप बाद में डैशबोर्ड सेटिंग्स स्क्रीन में वापस बदलाव कर सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pral chanje pou tablodbò klasik la. Ou ka tounen chanje pita nan ekran Paramèt Tablodbò a."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan beralih ke dashboard klasik. Anda dapat mengubahnya kembali nanti di layar Pengaturan Dashboard."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú ert að fara að skipta yfir í hefðbundna stjórnborðið. Þú getur breytt því seinna í stillingarglugganum fyrir stjórnborð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai per passare alla dashboard classica. Puoi tornare a questa visualizzazione successivamente nella schermata o Impostazioni dashboard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラシックダッシュボードに切り替えようとしています。後ほど「ダッシュボード設定」画面で元に戻すことができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "클래식 대시보드로 전환하려고 합니다. 대시보드 설정 메뉴에서 나중에 되돌릴 수 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei te tata koe ki te huri ki te papaaho tawhito. Ka taea e koe te huri anō ā muri ake nei i te mata Tautuhinga Papaaho."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda akan membuat pertukaran kepada papan pemuka klasik. Anda boleh mengubah semula kemudian dalam skrin Tetapan Papan Pemuka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er i ferd med å bytte til det klassiske dashbordet Du kan endre det tilbake senere på Dashbordinnstillinger-skjermen."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
