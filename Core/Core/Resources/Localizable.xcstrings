    "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بما أنها مناقشة لمجموعات، فإن لكل مجموعة محادثة خاصة لهذا الموضوع. فيما يلي النقاشات التي يمكنك الوصول إليها:"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atès que aquest és un fòrum de grup, cada grup té la seva conversa per a aquest tema. Aquests són els fòrums als quals teniu accés."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gan fod hon yn drafodaeth grŵp, mae gan bob grŵp ei sgwrs ei hun ar gyfer y pwnc hwn. Dyma’r trafodaethau mae gennych chi fynediad atyn nhw."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dette er en gruppediskussion, har hver gruppe sin egen Diskussion for dette emne. Her er de diskussioner, du har adgang til."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da dette er en gruppediskussion, har hver gruppe sin egen Diskussion for dette emne. Her er de diskussioner, du har adgang til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da es sich um eine Gruppendiskussion handelt, hat jede Gruppe ihr eigenen Gespräch zu diesem Thema. Dies sind die Diskussionen, zu denen Sie Zugang haben."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Since this is a group discussion, each group has its own conversation for this topic. Here are the discussions you have access to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tratarse de un foro grupal, cada grupo tiene su propia conversación en este foro. Estos son los foros a los que puede acceder."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al tratarse de un foro de discusión grupal, cada grupo tiene su propia conversación en este foro. Estos son los foros de discusión a los que puedes acceder."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koska tämä on ryhmäkeskustelu, jokaisella ryhmällä on oma keskustelu tällä aiheelle. Täällä on ne keskustelut, joihin sinulla on käyttöoikeus:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme il s'agit d'une discussion de groupe, chaque groupe possède sa propre conversation sur ce sujet. Voici les discussions auxquelles vous avez accès."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puisqu’il s’agit d’une discussion de groupe, chaque groupe a sa propre conversation pour ce sujet. Voici les discussions auxquelles vous avez accès."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ós rud é gur plé grúpa é seo, tá a chomhrá féin ag gach grúpa ar an ábhar seo. Seo iad na fóraim a bhfuil rochtain agat orthu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चूंकि यह एक ग्रुप चर्चा है, इसलिए इस विषय पर प्रत्येक ग्रुप की अपनी बातचीत होती है। वे चर्चाएं जिनका एक्सेस आपके पास है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lefèt ke sa a se yon gwoup diskisyon, chak gwoup gen pwòp konvèsasyon pa li pou sijè sa a. Men a ki diskisyon ou gen aksè."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karena ini adalah grup diskusi, setiap grup memiliki percakapannya sendiri untuk topik ini. Berikut ini adalah diskusi yang Anda memiliki akses kepadanya:"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þar sem þetta er hópumræða, hefur hver hópur eigið samtal um þetta efni. Þetta er það sem þú hefur aðgang að."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiché questa è una discussione di gruppo, ciascun gruppo ha la propria conversazione per questo argomento. Ecco le discussioni a cui hai accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはグループディスカッションのため、各グループはこのトピックについてそれぞれの会話を行います。利用するディスカッションは以下のとおりです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이것은 그룹 토론이므로 각 그룹에는 주제에 대한 자체 대화가 있습니다. 다음 토론에 액세스할 수 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mai te mea he kōrero rōpū tēnei, kei ia rōpū ngā kōrerorero mō tēnei kaupapa. Anei ngā kōrero hei whakauru atu mau."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oleh sebab ini ialah perbincangan kumpulan, setiap kumpulan mempunyai perbualan sendiri untuk topik ini. Ini ialah perbincangan yang boleh anda akses."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siden dette er en gruppe diskusjon, har hver gruppe en egen samtale for dette emne. Her er diskusjonene du har tilgang til."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siden dette er en gruppe diskusjon, har hver gruppe en egen samtale for dette fag. Her er diskusjonene du har tilgang til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangezien dit een groepsdiscussie is, voert elke groep zijn eigen gesprek over dit onderwerp. Hier zijn de discussies waartoe je toegang tot hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponieważ jest to dyskusja grupowa, każda grupa przeprowadza konwersację na ten temat. Tutaj znajdują się te, do których masz dostęp."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visto que esta é uma discussão de grupo, cada grupo tem uma conversa própria relativa a este tópico. Aqui estão as discussões aos quais tem acesso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como isso é um fórum de grupos, cada grupo tem sua própria conversa para esse assunto. Aqui estão os fóruns aos quais você tem acesso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
