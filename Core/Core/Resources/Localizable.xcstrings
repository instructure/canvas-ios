        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Error al sincronizar uno o más archivos. Compruebe su conexión a Internet y vuelva a entregarlos."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
