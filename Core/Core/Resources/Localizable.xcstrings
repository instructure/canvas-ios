        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "중요한 일이 발생하기를 기다립니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "E tatari ana mo ngā mahi nui kei te mahi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menunggu hingga perkara penting berlaku"
