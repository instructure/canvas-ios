          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content sync might use cellular data which may result in extra fees from your data provider."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Content sync might use cellular data which may result in extra fees from your data provider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización de contenido podría usar datos celulares, lo que puede resultar en una tarifa adicional de su proveedor de datos."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para la sincronización de contenido podrían consumirse datos móviles, lo cual puede añadir cargos adicionales al servicio de datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sisällön synkronisoinnissa saatetaan käyttää mobiilidataa, mistä saattaa aiheutua ylimääräisiä kustannuksia tietopalvelujesi tarjoajalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation du contenu est susceptible d'utiliser des données mobiles, ce qui peut entraîner une surfacturation par votre opérateur."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation de contenu peut utiliser des données cellulaires, ce qui peut entraîner des frais supplémentaires de la part de votre fournisseur de données."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seans go n-úsáidfidh sioncronú ábhair sonraí ceallacha a bhféadfadh táillí breise a bheith mar thoradh ar do sholáthraí sonraí."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सामग्री सिंक में मोबाइल डेटा का उपयोग हो सकता है जिसके परिणामस्वरूप आपके डेटा प्रदाता को अतिरिक्त शुल्क देना पड़ सकता है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senkwonizasyon kontni an ka itilize done selilè ki ka lakoz konpayi founisè done w la touche anplis."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi konten dapat menggunakan data seluler yang dapat menimbulkan biaya ekstra dari operator seluler Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samstilling efnis gæti notað farsímagögn sem geta leitt til aukagjalda frá gagnaveitunni þinni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione del contenuto potrebbe usare i dati del cellulare, cosa che potrebbe generare costi extra a favore del fornitore di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツの同期には携帯電話のデータを使用する場合があり、データプロバイダーからの追加料金が発生する場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "콘텐츠 동기화는 모바일 데이터를 사용하여 통신사에게 추가 비용을 발생시킬 수 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka whakamahia pea e te tukutahi ihirangi nga raraunga waea ka puta he utu taapiri mai i to kaiwhakarato raraunga."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segerakan kandungan mungkin menggunakan data selular yang boleh menyebabkan adanya bayaran tambahan daripada penyedia data anda."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering av innhold kan bruke mobildata, noe som kan føre til ekstra kostnader fra din leverandør."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering av innhold kan bruke mobildata, noe som kan føre til ekstra kostnader fra din leverandør."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contentsynchronisatie kan gebruikmaken van smartphonegegevens wat kan leiden tot extra kosten van je dataprovider."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
