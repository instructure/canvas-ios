    "You'll need to log in again due to your institute's security policy.\nOnce logged in, you can continue working seamlessly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستحتاج إلى تسجيل الدخول مرة أخرى بسبب السياسة الأمنية لمؤسستك التعليمية.\nبعد تسجيل الدخول، يمكنك متابعة العمل بسلاسة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haureu de tornar a iniciar la sessió a causa de la política de seguretat del vostre institut.\nQuan ja l’hàgiu iniciada, podreu continuar treballant sense interrupcions."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd angen i chi fewngofnodi eto oherwydd polisi diogelwch eich sefydliad.\nAr ôl mewngofnodi, gallwch barhau i weithio’n ddi-dor."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du skal logge ind igen på grund af dit instituts sikkerhedspolitik.\nNår du er logget ind, kan du fortsætte med at arbejde uden problemer."
          }
