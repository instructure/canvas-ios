        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smart Search, jota kehitetään parhaillaan Canvasille, käyttää semanttisia algoritmeja ja tekoälyä kyselyn kontekstin ja semanttisen merkityksen ymmärtämiseen, ei vain avainsanahaun."
