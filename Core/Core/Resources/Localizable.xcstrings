    "We couldn't add your Event at this time. You can try it again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم نتمكن من إضافة الحدث الخاص بك في هذا التوقيت. يمكنك إعادة المحاولة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En aquest moment, no hem pogut afegir el vostre esdeveniment. Podeu tornar a provar-ho."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doedd dim modd ychwanegu eich Digwyddiad ar hyn o bryd. Gallwch roi cynnig arall arni."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke tilføje din begivenhed på nuværende tidspunkt. Du kan prøve igen."
