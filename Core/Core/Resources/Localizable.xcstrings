    "As of June 1, 2024, searchable items include content pages, announcements, discussion prompts, and assignment descriptions, with plans to expand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعتبارًا من 1 يونيو 2024، تتضمن العناصر القابلة للبث صفحات المحتوى والإعلانات ومطالبات النقاش وأوصاف المهام، مع خطط للتوسيع."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partir de l’1 de juny de 2024, els elements en què es poden fer cerques inclouen pàgines de contingut, anuncis, sol·licituds de fòrums i descripcions d'activitats, amb plans d’ampliar-ho."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ers 1 Mehefin 2024, mae’r eitemau y gellir chwilio amdanynt yn cynnwys tudalennau cynnwys, cyhoeddiadau, awgrymiadau trafod, a disgrifiadau o aseiniadau. Mae cynlluniau i ychwanegu eitemau at y rhestr hon."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra 1. juni 2024 omfatter søgbare elementer indholdssider, beskeder, diskussionsprompter og opgavebeskrivelser, med planer om at udvide."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fra 1. juni 2024 omfatter søgbare elementer indholdssider, beskeder, diskussionsprompter og opgavebeskrivelser, med planer om at udvide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab dem 1. Juni 2024 können Sie unter anderem Inhaltsseiten, Ankündigungen, Diskussionsaufforderungen und Beschreibungen von Aufgaben durchsuchen, wobei eine Erweiterung geplant ist."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As of June 1, 2024, searchable items include content pages, announcements, discussion prompts, and assignment descriptions, with plans to expand."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As of June 1, 2024, searchable items include content pages, announcements, discussion prompts, and assignment descriptions, with plans to expand."
          }
        },
        "en-CA" : {
          "stringUnit" : {
