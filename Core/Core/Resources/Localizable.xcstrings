          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine oder mehrere Dateien wurden nicht synchronisiert. Überprüfen Sie Ihre Internetverbindung, und versuchen Sie es erneut."
          }
        },
        "en-AU" : {
          "stringUnit" : {
