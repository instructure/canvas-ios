        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de sus entregas aún se está cargando. Si cierra sesión, es posible que se interrumpa el proceso.\n¿Está seguro de que desea salir?"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una de tus entregas aún se está cargando. Si cierras sesión, es posible que se interrumpa el proceso.\n¿Estás seguro de que quieres salir?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhtä lähetyksistä ladataan. Jos kirjaudut ulos, tämä saattaa häiriytyä.\nHaluatko varmasti kirjautua ulos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'une de vos soumissions est en cours de téléchargement. Se déconnecter peut l'interrompre.\nVoulez-vous vraiment vous déconnecter ?"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un de vos envois est toujours en cours de téléversement. Se déconnecter pourrait l’interrompre.\nVoulez-vous vraiment vous déconnecter?"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tá ceann de d’uaslódálacha fós á uaslódáil. D'fhéadfadh logáil amach cur isteach air.\nAn bhfuil tú cinnte gur mhaith leat logáil amach?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका एक सबमिशन अभी भी अपलोड किया जा रहा है। लॉग आउट करने से इसमें रुकावट आ सकती है।\nक्या आप सच में लॉग आउट करना चाहते हैं?"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gen yonn nan soumisyon w yo ki toujou ap transfere. Si w dekonekte sa ka entewonp pwosesis la.\nOu kwè vrèman ou vle dekonekte?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu penyerahan Anda masih diunggah. Logout dapat menghentikannya.\nAnda yakin mau logout?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enn er verið að hlaða upp skilunum þínum. Útskráning gæti truflað ferlið.\nViltu örugglega skrá þig út?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caricamento di una delle consegne ancora in corso. Se ti disconnetti potresti interromperlo.\nDisconnettersi?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提出物の1つがまだアップロード中です。ログアウトすると中断する場合があります。\nログアウトしてもよろしいですか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 제출을 아직 업로드 중입니다. 로그아웃하면 중단될 수 있습니다.\n로그아웃하시겠습니까?"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ko tētahi o tō tāpaetanga kei te tikiake tonu tia. Takiuru ki waho ka whakararutia pea.\nKei te tino hiahia koe ki te takiuru atu?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salah satu serahan anda masih dalam proses muat naik. Mengelog keluar mungkin menjejaskannya.\nAdakah anda pasti anda ingin log keluar?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én av innleveringene dine lastes fortsatt opp. Hvis du logger ut, kan det forstyrre det.\nEr du sikker på at du vil logge ut?"
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én av innleveringene dine lastes fortsatt opp. Hvis du logger ut, kan det forstyrre det.\nEr du sikker på at du vil logge ut?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een van je inleveringen wordt nog steeds geüpload. Bij uitloggen kan dit worden onderbroken.\nWeet je zeker dat je wilt uitloggen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna z przesyłek jest nadal przesyłana. Wylogowanie mogłoby przerwać ten proces.\nCzy na pewno chcesz się wylogować?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma das suas submissões ainda está a ser carregada. A desconexão pode interrompê-la.\nTem a certeza de que quer terminar a sessão?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um dos seus envios ainda está sendo carregado. Desconectar-se pode interrompê-lo.\nTem certeza de que deseja sair?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один из отправляемых ресурсов еще выгружается. При выходе выгрузка может быть прервана.\nВы уверены, что вы хотите выйти?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ena vaših oddaj se še nalaga. Odjava bi lahko ta postopek prekinila.\nAli ste prepričani, da se želite odjaviti?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En av dina inlämningar laddas upp fortfarande. Om du loggar ut kan den avbrytas.\nVill du logga ut?"
