    "To re-order your courses tap and hold on a card then drag it to its new position." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإعادة ترتيب المساق، اضغط باستمرار على بطاقة، ثم اسحبها نحو وضعها الجديد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per tornar a demanar les assignatures, manteniu premuda una targeta i arrossegueu-la a la seva posició nova."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I aildrefnu eich cyrsiau tapiwch a gafael ar y cerdyn a’i lusgo i’w safle newydd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at omarrangere dine fag skal du trykke og holde et kort og derefter trække det hen til den nye position."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For at omarrangere dine fag skal du trykke og holde et kort og derefter trække det hen til den nye position."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Ihre Kurse neu anzuordnen, tippen und halten Sie eine Karte und ziehen Sie sie an ihre neue Position."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To re-order your courses tap and hold on a card then drag it to its new position."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To re-order your subjects tap and hold on a card then drag it to its new position."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To re-order your courses tap and hold on a card then drag it to its new position."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To re-order your modules tap and hold on a card then drag it to its new position."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To re-order your courses tap and hold on a card then drag it to its new position."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To re-order your modules tap and hold on a card then drag it to its new position."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reordenar los cursos, mantenga presionada una tarjeta y arrástrela a su nueva posición."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reordenar los cursos, mantén pulsada una tarjeta y arrástrala a la nueva posición."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä kurssit uudelleen koskettamalla korttia pitkään ja vetämällä se uuteen paikkaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour réorganiser vos cours, appuyez longuement sur une carte et faites-la glisser dans la position souhaitée."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour réorganiser vos cours, appuyez longuement sur une carte, puis faites-la glisser vers sa nouvelle position."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chun do chúrsaí a athordú, tapáil agus coinnigh ar chárta ansin tarraing chuig a áit nua é."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने पाठ्यक्रमों को पुनः क्रमित करने के लिए किसी कार्ड को टैप करके रखें और फिर उसे उसकी नई स्थिति में खींचें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pou w ka reòganize kou w yo, peze yon kat epi kenbe l, deplase l mete kote w vle mete l la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk mengatur ulang kursus Anda, ketuk dan tahan pada satu kartu lalu seret ke posisinya yang baru."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að endurraða námskeiðunum þínum skaltu smella á og halda á spjaldinu og draga það síðan í nýja stöðu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per riordinare i corsi toccare e tenere premuta una scheda, quindi trascinarla nella nuova posizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コースを並べ替えるには、カードをタップしたまま新しい位置までドラッグしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "과목 탭의 순서를 변경하려면 카드를 길게 눌러서 새 위치로 끕니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hei ota ano i o akoranga, pato me te pupuri i tetahi kaari ka toia ki tona waahi hou."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menyusun semula kursus anda, ketik dan tahan pada kad kemudian seret kursus ke kedudukan baharu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å endre rekkefølgen på emnene dine, trykk og hold på et kort, og dra det til sin nye posisjon."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å endre rekkefølgen på fagene dine, trykk og hold på et kort, og dra det til sin nye posisjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt de volgorde van je cursussen wijzigen door op een kaart te tikken, deze vast te houden en de kaart naar een andere positie te slepen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby uporządkować kursy, stuknij i przytrzymaj kartę, a następnie przeciągnij ją w nowe położenie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reordenar as suas disciplinas, toque sem soltar num cartão e arraste-o para a sua nova posição."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reordenar seus cursos, toque e segure um cartão e arraste-o para sua nova posição."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы изменить порядок своих курсов, нажмите и удерживайте карту, а затем перетащите ее на новое место."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če želite svoje predmete preurediti, tapnite in pridržite kartico, nato jo povlecite na novo mesto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att ändra ordningen på dina kurser drar du och släpper ett kort till sin nya position."
          }
        },
        "sv-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att ändra ordningen på dina kurser drar du och släpper ett kort till sin nya position."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จัดลำดับบทเรียนของคุณใหม่โดยกดค้างที่การ์ดจากนั้นลากไปยังตำแหน่งใหม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để sắp xếp lại khóa học của bạn, hãy nhấn và giữ thẻ sau đó kéo thẻ đến vị trí mới."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要对课程重新排序，请按住卡片，然后将其拖到新位置。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要对课程重新排序，请按住卡片，然后将其拖到新位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要重新排列課程順序，請點選並按住卡片，然後將其拖曳到新位置。"
          }
        },
