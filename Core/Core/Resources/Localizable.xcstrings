          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation d’un ou plusieurs fichiers a échoué. Vérifiez votre connexion Internet et réessayez l’envoi."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theip ar chomhad amháin nó níos mó a shioncronú. Seiceáil do nasc idirlín agus bain triail eile as é a chur isteach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक या अधिक फ़ाइलें सिंक होने में विफल रहीं। अपना इंटरनेट कनेक्शन जांचें और सबमिट करने का पुनः प्रयास करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gen yonn oswa plizyè fichye ki pa rive senkwonize. Verifye koneksyon entènèt ou a epi eseye re voye yo ankò"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu atau lebih file gagal disinkronkan. Periksa sambungan internet Anda dan coba serahkan lagi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekki tókst að samstilla eina eða fleiri skrár. Athugaðu nettenginguna þína og reyndu aftur að skila."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile sincronizzare uno o più file. Controlla la tua connessione Internet e riprova a inviare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つまたは複数のファイルが同期に失敗しました。インターネット接続をチェックしてから、提出を再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 개 이상의 파일을 동기화하지 못했습니다. 인터넷 연결을 확인하고 제출을 다시 시도하세요."
          }
        },
        "mi" : {
