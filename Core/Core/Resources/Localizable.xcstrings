        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos agregar su evento en esta ocasión. Puede intentarlo nuevamente."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hemos podido añadir tu evento en esta ocasión. Puedes intentarlo de nuevo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme voineet lisätä tapahtumaasi tällä kertaa. Voit yrittää tätä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous ne pouvons pas ajouter votre événement pour le moment. Vous pouvez réessayer."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons pas pu ajouter votre événement pour le moment. Vous pouvez réessayer."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níorbh fhéidir linn d'Imeacht a chur leis faoi láthair. Is féidir leat triail eile a bhaint arís."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम इस समय आपकी घटना नहीं जोड़ सके। आप इसे फिर से आज़मा सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nou paka ajoute Evènman w lan pou kounye a. Ou ka eseye ankò."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak bisa menambah Acara Anda saat ini. Anda bisa mencoba lagi."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við gátum ekki náð í viðburð þinn að sinni. Þú getur reynt aftur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non siamo riusciti ad aggiungere il tuo evento. Puoi riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "イベントを追加できませんでした。もう一度試してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 이벤트를 추가할 수 없습니다. 다시 시도해 볼 수 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaore i taea e matou te taapiri i to Takahanga i tenei wa. Ka taea e koe te ngana ano."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat menambah Acara anda pada masa ini. Anda boleh mencuba semula."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke legge til hendelsen på dette tidspunktet. Du kan prøve det igjen."
          }
        },
        "nb-instk12" : {
