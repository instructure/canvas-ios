    "Thanks for trying the new dashboard! Could you tell us why you switched back?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شكرًا لك على تجربة لوحة المعلومات الجديدة! هل من الممكن أن تخبرنا لماذا قمت بالرجوع إلى الشكل القديم؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gràcies per provar el nou panell de control Podríeu indicar-nos per què heu tornat a canviar a la versió anterior?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diolch am roi cynnig ar y dangosfwrdd newydd! Allech chi ddweud wrthyn ni pam eich bod wedi newid yn ôl?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak, fordi du prøvede den nye oversigt! Kan du fortælle os, hvorfor du skiftede tilbage?"
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tak, fordi du prøvede den nye oversigt! Kan du fortælle os, hvorfor du skiftede tilbage?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danke, dass Sie das neue Dashboard ausprobiert haben! Können Sie uns sagen, warum Sie zurück gewechselt haben?"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for trying the new dashboard! Could you tell us why you switched back?"
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thanks for trying the new dashboard! Could you tell us why you switched back?"
