        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devrez vous reconnecter en raison de la stratégie de sécurité de votre institution.\nUne fois connecté, vous pourrez continuer votre travail sans interruption."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devrez vous connecter à nouveau en raison de la politique de sécurité de votre institution.\nUne fois connecté, vous pouvez continuer à travailler en toute transparence."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beidh ort logáil isteach arís mar gheall ar pholasaí slándála d’institiúide.\nNuair a bheidh tú logáilte isteach, is féidir leat leanúint ar aghaidh ag obair gan dua."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके संस्थान की सुरक्षा नीति के कारण आपको पुनः लॉग इन करना होगा।\nएक बार लॉग इन करने के बाद, आप निर्बाध रूप से काम करना जारी रख सकते हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou bezwen konekte ankò akoz politik sekirite enstiti ou a.\nLè w fin konekte, ou ka kontinye travay nan tout transparans"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda harus login lagi dikarenakan kebijakan keamanan lembaga Anda.\nSetelah login, Anda dapat terus bekerja tanpa gangguan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú þarft að skrá þig aftur inn vegna öryggisstefnu stofnunar þinnar.\nEftir innskráningu getur þú haldið vinnu áfram með einföldum hætti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devi effettuare nuovamente l’accesso come previsto dalla politica sulla sicurezza del tuo istituto.\nEffettuato l’accesso, puoi continuare a lavorare regolarmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "機関のセキュリティポリシーにより、再度ログインする必要があります。\nログイン後は、シームレスに作業を継続できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "교육 기관의 보안 정책으로 다시 로그인해야 합니다.\n로그인한 후에는 원활하게 계속 작업할 수 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me takiuru ano koe na runga i te kaupapa here haumarutanga o to whare wananga.\nIna takiuru koe, ka taea e koe te mahi marie."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda perlu log masuk sekali lagi kerana dasar keselamatan institut anda.\nSebaik sahaja log masuk, anda boleh terus bekerja dengan lancar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du må logge inn igjen på grunn av institusjonens sikkerhetsregler.\nNår du har logget inn, kan du fortsette å jobbe sømløst."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du må logge inn igjen på grunn av institusjonens sikkerhetsregler.\nNår du har logget inn, kan du fortsette å jobbe sømløst."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je zult je opnieuw moeten aanmelden vanwege het beveiligingsbeleid van je instituut.\nZodra je bent aangemeld, kun je probleemloos doorwerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Musisz się zalogować ponownie z powodu polityki bezpieczeństwa Twojej instytucji.\nPo zalogowaniu możesz kontynuować pracę."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terá de iniciar sessão novamente devido à política de segurança do seu instituto.\nUma vez iniciada a sessão, pode continuar a trabalhar sem problemas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisará fazer login novamente devido à política de segurança do seu instituto.\nUma vez conectado, você pode continuar trabalhando sem problemas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В соответствии с политикой безопасности вашего учреждения вам необходимо войти в систему еще раз.\nВойдя в систему, вы сможете продолжить работу с того же места."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaradi varnostne politike vaše ustanove se boste morali znova prijaviti.\nKo se prijavite, lahko nemoteno nadaljujete z delom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du måste logga in igen på grund av ditt lärosätes säkerhetspolicy.\nNär du har loggat in igen kan du fortsätta arbeta utan avbrott."
          }
        },
        "sv-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du måste logga in igen på grund av din institutions säkerhetspolicy.\nNär du har loggat in igen kan du fortsätta arbeta utan avbrott."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะต้องล็อกอินอีกครั้งเนื่องจากเป็นนโยบายการการรักษาความปลอดภัยของหน่วยงานคุณ\nหลังจากล็อกอินแล้ว คุณจะสามารถดำเนินการต่อได้อย่างราบรื่น"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ cần phải đăng nhập lại do chính sách bảo mật của tổ chức.\nSau khi đăng nhập, bạn có thể tiếp tục làm việc liền mạch."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据贵机构的安全政策，您需要再次登录。\n登录后，您可以继续顺畅工作。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根据贵机构的安全政策，您需要再次登录。\n登录后，您可以继续顺畅工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於您機構的安全政策，您需要重新登入。\n一登入後，您即可無縫繼續工作。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於您機構的安全政策，您需要重新登入。\n一登入後，您即可無縫繼續工作。"
          }
        }
      }
    },
    "You're about to switch to the classic dashboard. You can change back later in Dashboard Settings screen." : {
