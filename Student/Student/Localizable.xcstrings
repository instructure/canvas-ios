          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway there — you've already done more than you think."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway there — you've already done more than you think."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway there — you've already done more than you think."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway there — you've already done more than you think."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya está a mitad de camino: hizo más de lo que cree."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya vas por la mitad: has logrado más de lo que imaginas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puolivälissä — olet jo tehnyt enemmän kuin luulet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te voilà à mi-parcours ! C’est déjà plus que ce que tu pensais."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mi-chemin, vous avez déjà fait plus que vous ne le pensez."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leath bealaigh ann — tá níos mó déanta agat cheana féin ná mar a cheapfá."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आधा काम हो गया है — आपने अपनी सोच से कहीं ज्यादा कर लिया है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou fè mwatye nan wout la deja — ou fè plis pase sa w kwè."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah setengah jalan — Anda sudah melakukan lebih dari yang Anda pikirkan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helmingnun lokið — þú hefur þegar gert meira en þú heldur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei a metà: hai già percorso più strada di quella che pensi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう半分まで来ました — あなたが思っている以上に、すでに多くのことを成し遂げています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작이 반입니다. 이미 생각보다 많은 것을 해냈습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kei waenganui o te ara — kua nui atu āu mahi i tāu i whakaaro ai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudah separuh jalan untuk mencapainya — anda sudah melakukan lebih daripada yang anda sangka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er halvveis – du har allerede gjort mer enn du tror."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er halvveis – du har allerede gjort mer enn du tror."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent halverwege – je het al meer gedaan dan je denkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połowę masz już za sobą – to więcej, niż Ci się wydaje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já estás na metade do caminho — já fizeste mais do que pensas."
