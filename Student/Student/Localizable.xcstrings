    "Morning! You've got this — one class, one step at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صباح الخير! أنت قادر على تحقيق هذا — فصل واحد، وخطوة واحدة في المرة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon dia! Teniu això: una classe, un pas cada vegada."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bore da! Galli di wneud hyn — un dosbarth, un cam ar y tro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godmorgen! Du skal nok klare det her – et trin ad gangen."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godmorgen! Du skal nok klare det her – et trin ad gangen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guten Morgen! Sie haben es in der Hand – eine Klasse, ein Schritt nach dem anderen."
          }
        },
