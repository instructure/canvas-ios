          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rentoudu, naura tai selaa syyllisyydettä — olet ansainnut sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détends-toi, ris ou scrolle sans culpabilité – tu l’as bien mérité !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Détendez-vous, riez ou défilez sans culpabilité — vous l’avez bien mérité."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lig do scíth, gáire, nó scrollaigh gan chiontacht — thuill tú é."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बिना किसी चिंता के आराम करें, हंसें या फ़ोन इस्तेमाल करें — आपने इसके लिए मेहनत की है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detann ou, ri, oswa defile san w pa santi w koupab — ou merite li."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersantai, tertawa, atau gulirkan layar tanpa rasa bersalah — Anda pantas mendapatkannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slakaðu á, hlæðu eða skrunaðu án sektarkenndar — þú hefur unnið þér það inn."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilassati, ridi o vai avanti senza rimorsi; ce l’hai fatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リラックスして、笑って、罪悪感なくスクロールしましょう — あなたの手柄です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "편하게 웃음을 짖고 마음껏 스크롤하세요. 그럴 자격이 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whakangāwari, kata, panuku rānei i te whārangi me te kore hara — he tika tāu mahi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bersantai, ketawa dan tatal saja tanpa rasa bersalah — anda telah berusaha."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvil deg, le eller bla uten skyldfølelse – du har fortjent det."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvil deg, le eller bla uten skyldfølelse – du har fortjent det."
          }
        },
        "nl" : {
          "stringUnit" : {
