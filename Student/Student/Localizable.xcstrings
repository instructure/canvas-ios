    "Evenings are for reflection — notice what you've learned today, not just what's left to do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأمسيات مثالية للتأمل — ألق نظرة على ما تعلمته اليوم، وليس ما عليك فعله فحسب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els vespres són per reflexionar: adoneu-vos del que heu après avui, no només d’allò que queda per fer."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae nosweithiau’n gyfle i fyfyrio — meddylia am yr hyn rwyt ti wedi'i ddysgu heddiw, nid dim ond yr hyn sydd ar ôl i'w wneud."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aftener er til refleksion – husk at lægge mærke til, hvad du har lært i dag, ikke kun alt det der stadig skal gøres."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aftener er til refleksion – husk at lægge mærke til, hvad du har lært i dag, ikke kun alt det der stadig skal gøres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Abende sind zum Nachdenken da – merken Sie sich, was Sie heute gelernt haben, nicht nur, was noch zu tun ist."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenings are for reflection — notice what you've learned today, not just what's left to do."
          }
        },
        "en-AU-unimelb" : {
