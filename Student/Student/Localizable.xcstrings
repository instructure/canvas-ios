        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes acceso a este contenido. La asignatura o grupo pueden no haber comenzado, o pueden haber finalizado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole pääsyä tähän sisältöön. Kurssi tai ryhmä ei ehkä ole vielä alkanut tai se on ehkä viety loppuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas accès à ce contenu. Ce cours ou ce groupe n’a peut-être pas encore commencé, ou il a peut-être pris fin."
