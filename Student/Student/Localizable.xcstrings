    "Anxiety gets louder at night — don't believe all its noise." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القلق يعلو صوته ليلاً — وتلك الضوضاء الصاخبة ليست حقيقية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ansietat es manifesta més per la nit; no us creieu tot el rebombori que provoca."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae’n hawdd poeni mwy gyda’r nos — paid â gadael iddo dy lethu di."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angsten kan føles mere larmende om natten – tro ikke på al dens støj."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angsten kan føles mere larmende om natten – tro ikke på al dens støj."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Angst wird nachts lauter – hören Sie einfach nicht hin."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety gets louder at night — don't believe all its noise."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety gets louder at night — don't believe all its noise."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety gets louder at night — don't believe all its noise."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety gets louder at night — don't believe all its noise."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety gets louder at night — don't believe all its noise."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anxiety gets louder at night — don't believe all its noise."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ansiedad se intensifica por la noche: no le haga caso."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando la noche amplifica la ansiedad, recuerda: solo es ruido, no realidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahdistus voimistuu öisin — älä usko kaikkea sen melua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est le soir que l’anxiété fait le plus de vacarme, n’y prête pas attention."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’anxiété s’intensifie la nuit — ne croyez pas tout le bruit."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éiríonn an imní níos airde san oíche — ná creid a torann ar fad."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रात में घबराहट और बढ़ जाती है — इसके शोर पर पूरी तरह यकीन न करें।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enkyetid vin pi fò lannwit — pa kwè tout bri li fè."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kecemasan semakin menggelegar di malam hari — jangan percaya semua kebisingannya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvíðinn verður háværari á nóttunni — trúðu ekki öllum hávaðanum."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ansia si fa sentire ancora di più durante la notte, non credere a tutto questo fracasso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不安は夜に増幅するもの — その心配事の全てを信じないで。気のせいです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "밤에는 걱정이 늘어납니다. 이런 생각을 믿지 마세요."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ka nui haere te manukanuka i te pō — kaua e whakapono ki tōna haruru katoa."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kebimbangan semakin bingit pada waktu malam  — usah percaya semua kebisingannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angsten blir høyere om natten – ikke tro på all ulyden."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angsten blir høyere om natten – ikke tro på all ulyden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zorgen klinken 's nachts luider – je hoeft niet al hun herrie te geloven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niepokój daje się we znaki wieczorem – nie ulegaj mu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ansiedade fica mais intensa à noite — não acredites em todo esse barulho."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ansiedade fica mais intensa à noite — não acredite em tudo o que ela diz."
          }
        },
        "ru" : {
          "stringUnit" : {
