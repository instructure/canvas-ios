    "Missing friends or mentors? Connection can come in small moments too." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تفتقد أصدقاءك أو معلميك؟ يمكن أن تتواصل للحظات قصيرة فحسب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trobeu a faltar les amistats o els mentors? Les connexions també poden arribar d’immediat."
