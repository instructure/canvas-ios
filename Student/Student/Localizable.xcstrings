    "Looks like you're free for this day.\nDo you want to add some To-dos?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أنك متاحًا لهذا اليوم.\nهل تريد إضافة بعض قوائم المهام؟"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembla que teniu lliure aquest dia.\nVoleu afegir-hi alguna tasca pendent?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae’n debyg eich bod yn rhydd y diwrnod hwn.\nYdych chi am ychwanegu Pethau i’w Gwneud?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ud til, at du har fri denne dag.\nVil du tilføje noget til opgavelisten?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es sieht so aus, als hätten Sie heute Zeit.\nMöchten Sie ein paar ToDos hinzufügen?"
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like you're free for this day.\nDo you want to add some To-dos?"
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like you're free for this day.\nDo you want to add some To-dos?"
          }
        },
