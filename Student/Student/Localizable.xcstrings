        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sigues clavando los codos? Muy respetable, pero no olvides que también hay que dormir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vieläkö painat täysillä? Arvostettavaa — mutta muista, että uni on osa elämää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encore en train de trimer ? Respect à toi, mais n’oublies pas que le sommeil, ça existe !"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toujours en train de broyer? Respect — mais n’oubliez pas que le sommeil existe."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ag meilt fós? Meas — ach ná déan dearmad go bhfuil codladh ann."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या अभी भी काम में लगे हुए हैं? सम्मान — लेकिन यह न भूलें कि नींद का भी अस्तित्व है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou toujou ap travay di? Respè — men sonje dòmi enpòtan."
