    "Not feeling ready? That's normal. Just start where you are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألا تشعر بأنك جاهز؟ هذا طبيعي. ابدأ من مكانك فحسب."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penseu que encara no esteu a punt? És normal. Comenceu en el punt en què us trobeu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ddim yn teimlo’n barod? Mae hynny’n normal. Dechreua lle wyt ti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føler du dig ikke klar? Det er helt normalt. Bare start der, hvor du er."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føler du dig ikke klar? Det er helt normalt. Bare start der, hvor du er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie fühlen sich noch nicht bereit? Das ist ganz normal. Fangen Sie einfach da an, wo Sie jetzt stehen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not feeling ready? That's normal. Just start where you are."
          }
        },
