          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siga adelante, su yo futuro se lo agradecerá."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue adelante, tu yo futuro te lo agradecerá."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jatka – tulevaisuudessa kiität itseäsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continue d’avancer, l’avenir te remerciera."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuez — vous vous en féliciterez à l’avenir."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lean ort — beidh buíochas agat as an todhchaí."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोशिश जारी रखो — आगे चलकर आपको खुद पर गर्व होगा।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontinye — lavni w ap genyen w rekonesans."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teruslah maju — diri Anda di masa depan akan berterima kasih pada Anda."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haltu áfram - í framtíðinni munt þú þakka þér."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ti fermare; il futuro ti ringrazierà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "続けてましょう — 未来の自分が感謝するでしょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "멈추지 말고 미래의 자신을 생각하세요."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me haere tonu - ka mihi koe ki a koe i te heke mai."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teruskan — diri anda pada masa depan akan berterima kasih."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett sånn – du vil takke deg i fremtiden."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett sånn – du vil takke deg i fremtiden."
          }
        },
