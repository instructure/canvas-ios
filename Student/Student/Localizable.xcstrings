    "Halfway there — you've already done more than you think." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنت في منتصف الطريق —  لقد حققت أكثر مما تظن."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja sou a meitat de camí: ja heu fet més del que penseu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rwyt ti hanner ffordd — rwyt ti wedi gwneud mwy nag wyt ti’n meddwl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er der næsten – du har allerede opnået mere, end du tror."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du er der næsten – du har allerede opnået mere, end du tror."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Hälfte ist geschafft – Sie haben schon mehr getan, als Sie denken."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway there — you've already done more than you think."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halfway there — you've already done more than you think."
          }
