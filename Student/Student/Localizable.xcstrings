    "Jobs, grades, the future… no one has it all figured out yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد شخص قد أدرك كل شيء... قد نحصل على الشهادات وندرك الوظائف، لكننا لا نعرف أبدًا المستقبل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feines, notes, el futur… ningú no ho ha esbrinat tot ja."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Swyddi, graddau, y dyfodol... does neb yn gwybod y cyfan eto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Job, karakterer, fremtiden … ingen har fundet ud af det hele endnu."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Job, vurderinger, fremtiden … ingen har fundet ud af det hele endnu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, Benotungen, die Zukunft ... niemand hat das alles schon durchschaut."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, grades, the future… no one has it all figured out yet."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, grades, the future… no one has it all figured out yet."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, grades, the future… no one has it all figured out yet."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, grades, the future… no one has it all figured out yet."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, grades, the future… no one has it all figured out yet."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobs, grades, the future… no one has it all figured out yet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo, las calificaciones, el futuro… Nadie lo tiene todo claro todavía."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El trabajo, las notas, el futuro... nadie lo tiene todo resuelto aún."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työt, arvosanat, tulevaisuus… kenelläkään ei ole kaikkea selvillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le métiers, les notes, l’avenir… rien n’est déjà tout tracé pour personne."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’emploi, les diplômes, l’avenir… personne n’a encore tout compris."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poist, gráid, an todhchaí… níl gach rud socraithe ag aon duine fós."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नौकरियां, नंबर, भविष्य... अभी तक किसी ने भी इन सबके बारे में पूरी तरह नहीं जाना है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travay, nòt, lavni... pèsonn poko gen tout bagay fikse byen."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pekerjaan, nilai, masa depan… belum ada yang memahami semuanya."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Störf, einkunnir, framtíðin... enginn hefur allt á hreinu ennþá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavori, voti, il futuro… nessuno ha già capito tutto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事、成績、将来…もう全てを理解している人は誰もいません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직업, 성적 그리고 미래... 모든 것을 다 아는 사람은 없습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngā mahi, ngā māka, te heke mai… kāore anō kia mōhiotia e tetahi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerja, gred, masa depan... tiada sesiapa yang sudah tahu kesudahannya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobber, vurderinger, fremtiden … ingen har funnet ut av alt ennå."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobber, vurderinger, fremtiden … ingen har funnet ut av alt ennå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Banen, cijfers, de toekomst... niemand heeft het al helemaal uitgevogeld. "
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zajęcia, oceny, przyszłość... nikt jeszcze tego wszystkiego nie ogarnął."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho, notas, futuro... ninguém tem tudo planeado ainda."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trabalho, notas, futuro... ninguém tem tudo planejado ainda."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Работа, оценки, будущее… никто еще не знает всего."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delo, ocene, prihodnost ... nihče še ni sam vsega razrešil."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobb, betyg, framtiden – allt behöver inte vara på plats än."
          }
        },
        "sv-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jobb, bedömningar, framtiden – allt behöver inte vara på plats än."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "งาน เกรด อนาคต...ค่อยเป็นค่อยไป"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công việc, điểm số, tương lai… không ai có tất cả câu trả lời."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工作、学业、前程……没有人能事事完美。"
          }
        },
        "zh-Hans" : {
