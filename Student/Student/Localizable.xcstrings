          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 콘텐츠에 대한 액세스가 없습니다. 과목 또는 그룹이 시작되지 않았거나 종결되었을 수 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaore koe e whai urunga ki tēnei ihirangi. Kare anō pea te Akoranga Rōpū rānei i timata, a, kua mutu kē pea."
          }
