    "The future isn't built in a day — but you're on the way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تحقق المستقبل في يوم واحد — لكنك في طريقك لتحققه."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El futur no es construeix en un dia, però esteu en el camí."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dwyt ti ddim yn gallu creu dy ddyfodol mewn diwrnod — ond rwyt ti ar dy ffordd."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremtiden bygges ikke på én dag – men du er på vej."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fremtiden bygges ikke på én dag – men du er på vej."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
