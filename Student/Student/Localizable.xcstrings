    "Even if today felt messy, you showed up. That matters." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى لو شعرت إن الأمور مربكة، فأنت حضرت. وهذا ما يهم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encara que avui hagi estat un dia desordenat, heu progressat. Això importa."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyd yn oed os nad oedd heddiw’n berffaith, fe ddest ti drwyddi. Dyna sy’n bwysig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvom i dag ikke var helt optimal, så gjorde du dit bedste. Det betyder noget."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selvom i dag ikke var helt optimal, så gjorde du dit bedste. Det betyder noget."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch wenn der heutige Tag chaotisch war, Sie waren da. Das ist wichtig."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Even if today felt messy, you showed up. That matters."
          }
