          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous n’avons pas pu synchroniser votre contenu.\nRéessayez ou revenez plus tard."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní raibh muid in ann d’ábhar a shioncronú.\nDéan iarracht arís, nó tar ar ais níos déanaí."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपकी सामग्री सिंक नहीं कर सके।\nफिर से प्रयास करें, या बाद में आएं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nou pa t ka senkronize kontni w lan.\nEseye ankò, oswa tounen pita."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat menyinkronkan konten Anda.\nCoba lagi, atau kembali lagi nanti."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Við gátum ekki samstillt efnið þitt.\nReyndu aftur eða komdu aftur síðar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile sincronizzare il contenuto.\nRiprova, o ritorna più tardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツの同期に失敗しました。\nもう一度やってみるか、また後で戻ってきてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "콘텐츠를 동기화할 수 없습니다.\n다시 시도하거나 나중에 돌아오세요."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kāore i taea e mātou te tukutahi i ō ihirangi.\nNgāna anō, me hoki mai anō ā muri ake nei."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
