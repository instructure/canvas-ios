            "value" : "Bonjour ! Tu vas y arriver, un cours, un pas à la fois."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matin! Vous y arriverez — une classe, une étape à la fois."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maidin! Tá seo agat - rang amháin, céim amháin ag an am."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शुभ प्रभात! आपने कर दिखाया — एक समय में एक कक्षा, एक कदम।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjou! Ou ka fè sa — yon klas, pazapa."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagi! Anda pasti bisa — satu kelas, selangkah demi selangkah."
