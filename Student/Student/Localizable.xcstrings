        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’avenir ne s’est pas construit en un jour — mais vous êtes en route."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ní thógtar an todhchaí i lá amháin - ach tá tú ar an mbealach."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भविष्य एक दिन में नहीं बनता — लेकिन आप उसी रास्ते पर हैं।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavi kap vini an pa konstwi nan yon sèl jou — men w sou wout la."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masa depan tidak dibangun dalam sehari — tetapi Anda sedang menuju ke sana."
