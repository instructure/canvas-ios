    "Keep going — future you will thank you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمر — ستشكر نفسك مستقبلاً."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguiu així, ho agraireu en el futur."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dal ati — byddi di’n falch yn y dyfodol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt – du vil takke dig selv i fremtiden."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsæt – du vil takke dig selv i fremtiden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Machen Sie weiter – Ihre Zukunft wird es Ihnen danken."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep going — future you will thank you."
          }
        },
