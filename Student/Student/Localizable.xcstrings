    "If worries feel heavy, remember you don't have to carry them alone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا كانت المخاوف ثقيلة، فتذكر أنك غير مضطر لأن تحملها وحيدًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si teniu moltes preocupacions, recordeu que no cal que us hi enfronteu en solitari."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os wyt ti’n poeni, cofia rannu dy boenau ag eraill."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis bekymringerne føles tunge, så husk, at du ikke behøver at bære dem alene."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis bekymringerne føles tunge, så husk, at du ikke behøver at bære dem alene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn die Sorgen Sie erdrücken, denken Sie daran, dass Sie sie nicht allein tragen müssen."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If worries feel heavy, remember you don't have to carry them alone."
