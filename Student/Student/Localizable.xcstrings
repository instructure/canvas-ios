          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like you're free for this day.\nDo you want to add some To-dos?"
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Looks like you're free for this day.\nDo you want to add some To-dos?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que está libre este día.\n¿Quiere agregar algunas tareas pendientes?"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que tienes el día libre.\n¿Quieres añadir algunas tareas pendientes?"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näyttää siltä,​että sinulla on vapaata tältä päivältä.\nHaluatko lisätä nämä tehtävät?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il semble que vous êtes libre aujourd’hui.\nVoulez-vous ajouter des tâches À Faire ?"
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is cosúil go bhfuil tú saor don lá seo.\nAr mhaith leat roinnt Tascanna a chur leis?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लगता है आज आप खाली हैं।\nक्या आप कुछ 'करने के लिए' जोड़ना चाहते हैं?"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanble ou lib pou jounen sa a.\nÈske w vle ajoute kèk bagay pou fè?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sepertinya Anda bebas untuk hari ini.\nAnda mau menambahkan beberapa to-do?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú virðist vera laus þennan dag.\nViltu bæta við nokkrum verkefnalistum?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che oggi tu non abbia impegni.\nVuoi aggiungere qualche attività?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日は予定がないようです。\nするべきことに何か追加しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘은 할 일이 없는 것 같습니다.\n할 일을 추가하시겠습니까?"
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te āhua nei kua wātea koe mō tēnei rā.\nKei te hiahia koe ki te tāpiri i ētahi mahi?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut til at du er ledig i dag.\nVil du legge til noen gjøremål?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het lijkt erop dat je deze dag vrij hebt.\nWil je een paar opdrachten toevoegen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygląda na to, że nie masz dziś zajęć.\nCzy chcesz dodać listy zadań?"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que estás livre hoje.\nQueres adicionar algumas tarefas?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que você está livre hoje.\nDeseja adicionar algumas tarefas à sua lista?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Похоже, сегодня вы свободны.\nХотите добавить несколько задач?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaže, da ste danes prosti.\nAli želite dodati nekaj opravil?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det ser ut som om du är ledig för dagen.\nVill du lägga till några att göra-uppgifter?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูเหมือนคุณจะว่างในวันนี้\nต้องการเพิ่มรายการดำเนินการหรือไม่"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có vẻ như bạn rảnh vào ngày này.\nBạn có muốn thêm một số Việc Cần Làm không?"
          }
        },
        "zh" : {
