    "Reach out if you're stuck — support is always closer than it feels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تواصل مع شخص آخر إذا كنت تشعر بأنك عالق في مكانك — فالدعم دائمًا أقرب مما نتصور."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demaneu ajuda si sentiu que us heu estancat: sempre tindreu suport més a prop del que penseu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os wyt ti’n teimlo’n sownd, chwilia am gymorth – mae’n agosach nag wyt ti’n meddwl."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed om hjælp, hvis du sidder fast – støtten er altid tættere på, end den føles."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bed om hjælp, hvis du sidder fast – støtten er altid tættere på, end den føles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenden Sie sich an uns, wenn Sie nicht weiterkommen – Unterstützung ist ganz in der Nähe."
          }
        },
        "en-AU" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach out if you're stuck — support is always closer than it feels."
          }
        },
        "en-AU-unimelb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach out if you're stuck — support is always closer than it feels."
          }
        },
        "en-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach out if you're stuck — support is always closer than it feels."
          }
        },
        "en-CY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach out if you're stuck — support is always closer than it feels."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach out if you're stuck — support is always closer than it feels."
          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reach out if you're stuck — support is always closer than it feels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pida ayuda si siente que no avanza; el apoyo siempre está más cerca de lo que parece."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te estancas, pide ayuda: el apoyo está siempre más cerca de lo que parece."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ota yhteyttä, jos olet jumissa — tuki on aina lähempänä kuin miltä tuntuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’hésite pas à tendre la main, si tu te sens dans une impasse. Trouver de l’aide est plus facile qu’il n’y paraît."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tendez la main en cas de difficulté : le soutien est toujours plus proche qu’il n’y paraît."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Téigh i dteagmháil má tá tú i bhfostú — bíonn tacaíocht i gcónaí níos gaire ná mar a shíleann tú."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगर आप फंस गए हैं, तो मदद माँगें — तुरंत मदद मिलेगी।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakte nou si w bloke — èd la toujou pi pre pase sa w santi."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mintalah bantuan jika Anda mengalami kesulitan — dukungan selalu lebih dekat daripada yang Anda rasakan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hafðu samband ef þú ert fastur/föst — stuðningurinn er alltaf nær en hann virðist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contattaci se non riesci a proseguire; il supporto è più vicino di quanto sembra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行き詰まったら声をかけてください — サポートはいつも思っているより近くにあるものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 나아갈 수 없다고 생각되면 도움을 요청하세요. 도움은 생각보다 가까이에 있습니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whakapā mai mēnā kei te raru koe — he tata tonu te tautoko i tōu whakaaro."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hubungi seseorang jika anda tertekan — sokongan selalunya lebih dekat daripada yang anda sangka."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kontakt hvis du står fast – støtten er alltid nærmere enn den føles."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta kontakt hvis du står fast – støtten er alltid nærmere enn den føles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag om hulp als je vastzit – hulp is altijd dichterbij dan je denkt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poproś o pomoc, jeśli masz problem – wsparcie jest zawsze bliżej, niż się wydaje."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procure ajuda se estiver com dificuldades — o apoio está sempre mais perto do que parece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você estiver com dificuldades, não hesite em pedir ajuda — o apoio está sempre mais perto do que você imagina."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обратитесь за помощью, если у вас возникли трудности — поддержка всегда ближе, чем кажется."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Če ste obtičali, poiščite pomoč – podpora je vedno bližje, kot se zdi."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om hjälp om du har fastnat – den finns närmare än vad du tror."
          }
        },
        "sv-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Be om hjälp om du har fastnat – den finns närmare än vad du tror."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
