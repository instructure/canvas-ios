        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme voineet synkronoida maksuasi.\nYritä uudelleen tai palaa takaisin myöhemmin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
