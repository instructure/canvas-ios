          }
        },
        "en-GB-instukhe" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Evenings are for reflection — notice what you've learned today, not just what's left to do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tardes son para reflexionar: fíjese en lo que aprendió hoy y no solo en lo que le queda por hacer."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tardes son para reflexionar: fíjate en lo que has aprendido hoy, no solo en lo que te queda por hacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illat ovat pohdintaa varten — huomaa, mitä opit tänään, älä vain sitä mitä jäi tekemättä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le soir est un moment idéal pour réfléchir. Pense à ce que tu as appris aujourd’hui, et pas seulement à tout ce qu’il te reste à faire."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les soirées sont consacrées à la réflexion — remarquez ce que vous avez appris aujourd’hui, et pas seulement ce qu’il vous reste à faire."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Is le haghaidh machnaimh atá na tráthnónta — tabhair faoi deara an méid atá foghlamtha agat inniu, ní hamháin a bhfuil le déanamh fós."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शामें चिंतन के लिए होती हैं — इस बात पर ध्यान दें कि आज आपने क्या सीखा है, न कि केवल इस पर कि क्या करना बाकी है।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aswè se pou refleksyon — remake sa w aprann jodi a, pa sèlman sa ki rete pou w fè yo."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malam hari adalah untuk refleksi — perhatikan apa yang telah Anda pelajari hari ini, bukan hanya apa yang masih harus dilakukan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvöldin eru til íhugunar — taktu eftir því sem þú hefur lært í dag, ekki bara því sem eftir er að gera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sera serve per riflettere: pensa a ciò che hai imparato oggi, non solo a ciò che devi ancora fare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜は振り返りの時間です — やり残した課題だけでなく、今日学んだことに目を向けましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저녁 시간은 오늘 완료하지 못한 것 뿐만 아니라 오늘 배운 것을 뒤돌아볼 수 있는 시간입니다."
          }
        },
        "mi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He mea whakaaroaro ngā ahiahi — tirohia ngā mea kua akohia e koe i tēnei rā, kaua ko ngā mea anake hei mahi."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu malam adalah untuk membuat perenungan — perhatikan apa yang telah anda pelajari hari ini, bukan hanya perkara yang masih berbaki untuk dilakukan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvelder er til for refleksjon – legg merke til hva du har lært i dag, ikke bare hva som gjenstår."
          }
        },
        "nb-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kvelder er til for refleksjon – legg merke til hva du har lært i dag, ikke bare hva som gjenstår."
          }
        },
        "nl" : {
          "stringUnit" : {
