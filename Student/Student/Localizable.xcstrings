    "You do not have access to this content. The Course or Group may not have started, or may have been concluded." : {
      "comment" : "Error message for an unauthorized course or group.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنك الوصول إلى هذا المحتوى. من الممكن أن هذا المساق أو المجموعة لم يبدأ بعد أو انتهى."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No teniu accés a aquest contingut. Pot ser que l'assignatura o el grup encara no hagin començat, o bé que ja hagin finalitzat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Does gennych chi ddim mynediad at y cynnwys hwn. Efallai fod y Cwrs neu'r Grŵp wedi dirwyn i ben neu heb ddechrau."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke adgang til dette indhold. Fag eller gruppe er muligvis ikke startet, eller er måske afsluttet."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ikke adgang til dette indhold. Fag eller gruppe har muligvis ikke startet, eller måske afsluttet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben auf diesen Content keinen Zugriff. Möglicherweise wurde der Kurs oder die Gruppe noch nicht begonnen oder wurde geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
