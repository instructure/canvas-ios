        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n'avez pas accès à ce contenu. Le cours ou le groupe peut ne pas avoir commencé, ou peut avoir été terminé."
          }
        },
        "ga" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Níl rochtain agat ar an ábhar seo. Seans nár thosaigh an Cúrsa nó an Grúpa, nó go bhfuil sé tugtha chun críche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास इस सामग्री का एक्सेस नहीं है। हो सकता है कि पाठ्यक्रम या ग्रुप शुरू न हुआ हो, या समाप्त हो गया हो।"
          }
        },
        "ht" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou pa gen otorizasyon pou kontni sa a. Kou a oswa Gwoup la ka poko k[omanse, oswa yo ka gentan fini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda tidak memiliki akses ke konten ini. Kursus atau Grup mungkin belum dimulai, atau telah selesai."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þú hefur ekki aðgang að þessu efni. Verið getur að námskeiðið eða hópurinn sé ekki byrjað, eða því er lokið."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai accesso a questo contenuto. Il Corso o il Gruppo potrebbero non essere iniziati oppure potrebbero essere stati conclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
