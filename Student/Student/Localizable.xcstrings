        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque hoy haya sido un día complicado, se esforzó. Eso importa."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aunque el día de hoy te haya parecido un poco caótico, has estado presente. Eso cuenta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaikka päivä tuntui sekavalta, sinä olit paikalla. Sillä on merkitystä."
          }
        },
        "fr" : {
