    "Relax, laugh, or scroll guilt-free — you earned it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استرخ أو امرح أو تصفح الإنترنت دون أن تشعر بالذنب — فأنت تستحق هذا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relaxeu-vos, rieu o feu una volta sense sentir-vos culpable; us ho heu guanyat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cer i ymlacio, chwerthin, neu sgrolio ar dy ffôn — rwyt ti’n ei haeddu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan slappe af, grine eller scrolle uden skyldfølelse – du har fortjent det."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
