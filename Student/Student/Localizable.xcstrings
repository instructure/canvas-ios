    "We couldn't sync your content.\nTry again, or come back later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم نتمكن من مزامنة المحتوى الخاص بك.\nحاول مجددًا، أو عد لاحقًا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hem pogut sincronitzar el contingut.\nProveu-ho de nou o torneu més endavant."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doedd dim modd cysoni eich cynnwys.\nRhowch gynnig arall arni neu ddod yn ôl rywbryd eto."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke synkronisere dit indhold.\nPrøv igen, eller kom tilbage senere."
          }
        },
        "da-instk12" : {
          "stringUnit" : {
            "state" : "translated",
